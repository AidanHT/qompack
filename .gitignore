# Qompack runtime store — never committed
/.qompack/
**/.qompack/

# Build artifacts
/bin/
/dist/
/plugin/bin/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
/testdata/bench-*.json

# Recorded sessions contain user code and prompts
/testdata/sessions/recorded/*
!/testdata/sessions/recorded/.gitkeep

# pgregory.net/rapid writes a *.fail replay file here when a property test fails, next to the
# package that failed. It is a failure artifact, not a fixture: committing one would freeze a
# counterexample into the tree where it reads like a seed corpus.
**/testdata/rapid/

# Tooling
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
