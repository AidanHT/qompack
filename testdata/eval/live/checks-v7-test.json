{
  "version": 1,
  "id": "qompack-live-check-test",
  "description": "Test-only (V7 W6 item 11): two checks shaped like R1's, graded on the recorded 2.1.280 smoke streams. It is never run against a real host; the default R1 suite is WR's.",
  "model": "claude-opus-5-5",
  "defaults": {
    "max_turns": 4,
    "allowed_tools": [
      "Read"
    ]
  },
  "checks": [
    {
      "id": "compact-recall",
      "title": "A fact stated before /compact is recalled after it, with no plugin",
      "fixture": "fixtures/pilot",
      "steps": [
        {
          "id": "state",
          "prompt": "Remember this: the release codeword is HELIOTROPE-47. Reply with the codeword."
        },
        {
          "id": "compact",
          "compact": true
        },
        {
          "id": "ask",
          "prompt": "What is the release codeword? Answer in one line."
        }
      ],
      "repeat": {
        "quick": 1,
        "metrics": 3
      },
      "model_dependent": true,
      "record": [
        "host_model",
        "claude_code_version",
        "compactions",
        "rate_limits",
        "stream_lines"
      ],
      "pass": [
        {
          "kind": "completed",
          "description": "every step ended in a result and the compaction compacted"
        },
        {
          "kind": "answer_matches",
          "step": "ask",
          "pattern": "HELIOTROPE-47",
          "description": "the codeword is recalled"
        }
      ],
      "metric": "rate_limit_events"
    },
    {
      "id": "plugin-loads",
      "title": "The bundle loads by --plugin-dir and its hooks run",
      "probe": "bundle",
      "fixture": "fixtures/pilot",
      "env": {
        "QOMPACK_RUNTIME__MOD__ENABLED": "false"
      },
      "steps": [
        {
          "id": "state",
          "prompt": "Remember this: the release codeword is HELIOTROPE-47. Reply with the codeword."
        },
        {
          "id": "compact",
          "compact": true
        },
        {
          "id": "ask",
          "prompt": "What is the release codeword? Answer in one line."
        }
      ],
      "repeat": {
        "quick": 1,
        "metrics": 1
      },
      "record": [
        "plugins",
        "hooks",
        "files:.qompack/checkpoints/*"
      ],
      "pass": [
        {
          "kind": "plugin_loaded",
          "name": "qompack",
          "description": "the host lists Qompack as loaded"
        },
        {
          "kind": "stream_lines",
          "line": "system/hook_response",
          "min": 1,
          "description": "at least one hook responded"
        }
      ]
    }
  ]
}
