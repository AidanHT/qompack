 // waitForConns waits for every in-flight handleConn goroutine to finish, bounded by
 // serverCloseWait — the same bound Close itself uses — so neither Serve nor Close can hang the
-// daemon's stop sequence forever on a single wedged connection. It is safe to call from both:
-// sync.WaitGroup.Wait may be called by multiple goroutines concurrently as long as none of them
-// is also calling Add, and by the time either caller reaches this point the accept loop that
-// calls Add has already stopped.
+// daemon's stop sequence forever on a single wedged connection. Serve's own shutdown paths and an
+// independently-invoked Close can both reach this concurrently, which sync.WaitGroup permits: per
+// its documentation, an Add that takes the counter from zero to positive may race with a Wait —
+// what it forbids is calling Add again after a Wait has already observed zero and returned, which
+// cannot happen here because every s.wg.Add lives inside the accept loop, and that loop's own
+// Accept calls only ever fail once the listener this Close (or the ctx cancellation that triggers
+// it) has closed — no Add can start a fresh cycle after the final Wait of a shutdown exits.
 func (s *server) waitForConns() {
 	done := make(chan struct{})
 	go func() {
 		s.wg.Wait()
 		close(done)
 	}()
 	t := time.NewTimer(serverCloseWait)
 	defer t.Stop()
 	select {
 	case <-done:
