+// the mode is cleared first — harmless on POSIX, where file permissions never gate an unlink.
+func removeSpawnLock(lockPath string) {
+	_ = os.Chmod(paths.Long(lockPath), 0o600)
+	_ = os.Remove(paths.Long(lockPath))
+}
