diff --git a/test/integration/hotpath_test.go b/test/integration/hotpath_test.go
index c82b1e3..5705c83 100644
--- a/test/integration/hotpath_test.go
+++ b/test/integration/hotpath_test.go
@@ -769,6 +769,21 @@ func TestIntegration_HotPathWarmWithRealResidentState(t *testing.T) {
 	close(pollStop)
 	pollWG.Wait()
 
+	// SCRATCH DIAGNOSTIC (not for merge): the daemon's own record, before any harness verdict.
+	t.Logf("DIAG-EARLY runErr=%v sawDaemonState=%v sawSpool=%v polls=%d spoolPolls=%d firstSpoolAtMs=%d degradedWarns=%d",
+		runErr, sawDaemonState.Load(), sawSpool.Load(), diagPolls.Load(), diagSpoolPolls.Load(), diagFirstSpool.Load(),
+		hotpathCountDegradedWarns(t, p))
+	if early, globErr := filepath.Glob(filepath.Join(paths.Of(p.Root).Logs, "*.log")); globErr == nil {
+		for _, f := range early {
+			b, _ := os.ReadFile(f)
+			for _, line := range strings.Split(string(b), "\n") {
+				if strings.Contains(line, "hot window") || strings.Contains(line, "hot path") ||
+					strings.Contains(line, "hot-path submode") {
+					t.Logf("DIAG-EARLY %s: %s", filepath.Base(f), line)
+				}
+			}
+		}
+	}
 	t.Logf("bench harness stdout:\n%s", stdout.String())
 	if raw, readErr := os.ReadFile(jsonPath); readErr == nil {
 		t.Logf("bench artifact %s:\n%s", jsonPath, raw)
