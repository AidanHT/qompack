+
+// submit feeds one prompt through OnUserPrompt and returns its output.
+func (h *harness) submit(text string) Output {
+	h.t.Helper()
+	out, err := h.obs.OnUserPrompt(context.Background(), promptOf(text))
+	require.NoError(h.t, err)
