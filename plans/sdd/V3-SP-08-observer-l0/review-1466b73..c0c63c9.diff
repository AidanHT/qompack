+		TodoCompleted: hasCompletedTodo(e),
+		TestPassed:    ExtractTestOutcome(e) == TestPass,
+		GitCommit:     isGitCommit(e),
+		Paths:         PathsFromInput(e.ToolName, e.ToolInput),
